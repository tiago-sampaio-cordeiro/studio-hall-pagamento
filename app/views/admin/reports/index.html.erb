<div class="max-w-5xl mx-auto px-4">
  <%= render Pages::PageTitleComponent.new(title: "Relatórios") %>
  <div class="bg-white shadow-md rounded-lg p-4 md:p-6 mb-8">
    <%= form_with url: admin_reports_path, method: :get, local: true,
                  class: "grid grid-cols-1 md:grid-cols-3 gap-4 items-end" do %>
      <div class="flex flex-col">
        <label class="text-sm font-medium text-gray-700 mb-1">
          Data Inicial
        </label>
        <%= date_field_tag :start_date, params[:start_date],
                           class: "border rounded-md px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div class="flex flex-col">
        <label class="text-sm font-medium text-gray-700 mb-1">
          Data Final
        </label>
        <%= date_field_tag :end_date, params[:end_date],
                           class: "border rounded-md px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <%= submit_tag "Filtrar",
                       class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition w-full sm:w-auto" %>
        <%= link_to "Mês Atual", admin_reports_path,
                    class: "bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 transition text-center w-full sm:w-auto" %>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-5xl mx-auto px-4">
  <%# ===== DESKTOP: tabela (md e acima) ===== %>
  <div class="hidden md:block bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Funcionário
        </th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Detalhes
        </th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Horas
        </th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Valor/hora ou salário
        </th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
          Pagamento
        </th>
      </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
      <% @results&.each do |result| %>
        <tr class="hover:bg-gray-50 transition">
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
            <%= result[:employee].user.first_name %>
            <%= result[:employee].user.last_name %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
            <%= link_to "Ver Detalhes", admin_employee_reports_path(result[:employee]),
                        class: "text-blue-600 hover:underline" %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
            <%= format_hours(result[:hours]) %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-800">
            <% if result[:employee].clt? %>
              <%= number_to_currency(result[:employee].salary, unit: "R$", separator: ",", delimiter: ".") %>
            <% else %>
              <%= number_to_currency(result[:employee].hourly_rate, unit: "R$", separator: ",", delimiter: ".") %>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-800">
            <%= number_to_currency(result[:amount], unit: "R$", separator: ",", delimiter: ".") %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <%# ===== MOBILE: cards empilhados (abaixo de md) ===== %>
  <div class="md:hidden space-y-4">
    <% @results&.each do |result| %>
      <div class="bg-white shadow-md rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
          <span class="text-base font-semibold text-gray-900">
            <%= result[:employee].user.first_name %> <%= result[:employee].user.last_name %>
          </span>
          <%= link_to "Detalhes", admin_employee_reports_path(result[:employee]),
                      class: "text-blue-600 text-sm hover:underline shrink-0 ml-2" %>
        </div>
        <dl class="grid grid-cols-2 gap-y-2 text-sm">
          <dt class="text-gray-500">Horas</dt>
          <dd class="text-gray-800 text-right"><%= format_hours(result[:hours]) %></dd>

          <dt class="text-gray-500">
            <%= result[:employee].clt? ? "Salário" : "Valor/hora" %>
          </dt>
          <dd class="text-gray-800 text-right">
            <% if result[:employee].clt? %>
              <%= number_to_currency(result[:employee].salary, unit: "R$", separator: ",", delimiter: ".") %>
            <% else %>
              <%= number_to_currency(result[:employee].hourly_rate, unit: "R$", separator: ",", delimiter: ".") %>
            <% end %>
          </dd>

          <dt class="text-gray-500 font-medium">Pagamento</dt>
          <dd class="text-gray-900 font-semibold text-right">
            <%= number_to_currency(result[:amount], unit: "R$", separator: ",", delimiter: ".") %>
          </dd>
        </dl>
      </div>
    <% end %>
  </div>
</div>