<% if notice = flash[:notice] %>
  <div class="mb-6 px-4 py-3 ml-10 mr-10 bg-emerald-950 border border-emerald-700 text-emerald-400 text-sm rounded-lg text-center tracking-wide">
    <%= notice %>
  </div>
<% end %>
<% if alert = flash[:alert] %>
  <div class="mb-6 px-4 py-3 ml-10 mr-10 bg-rose-950 border border-rose-700 text-rose-400 text-sm rounded-lg text-center tracking-wide">
    <%= alert %>
  </div>
<% end %>